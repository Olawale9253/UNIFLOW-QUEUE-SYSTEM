# Supabase: Project Settings > Database > Connection string > JDBC
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

# Generate a long random value for production.
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=https://uniflow-queue-system-1.onrender.com,http://localhost:3000
APP_FRONTEND_URL=https://uniflow-queue-system-1.onrender.com

MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password